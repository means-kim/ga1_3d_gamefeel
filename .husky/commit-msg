#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# 커밋 메시지 파일
COMMIT_MSG_FILE="$1"

# 첫 번째 줄 가져오기
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE")

# 커밋 메시지 규칙 검사
if ! echo "$COMMIT_MSG" | grep -qE '^(asset|build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\(.+\))?!?: .+'; then
    echo "❌ 커밋 메시지는 'type: 설명' 형식이어야 합니다."
    echo ""
    echo "예시:"
    echo "  feat: 플레이어 이동 기능 추가"
    echo "  fix: 총알 충돌 오류 수정"
    echo "  docs: README 수정"
    exit 1
fi

# type 추출
TYPE=$(echo "$COMMIT_MSG" | sed -E 's/^([a-z]+).*/\1/')

# type에 따른 이모지 설정
case "$TYPE" in
    asset)
        EMOJI="🎨"
        ;;
    build)
        EMOJI="📦"
        ;;
    chore)
        EMOJI="🔧"
        ;;
    ci)
        EMOJI="👷"
        ;;
    docs)
        EMOJI="📝"
        ;;
    feat)
        EMOJI="✨"
        ;;
    fix)
        EMOJI="🐛"
        ;;
    perf)
        EMOJI="⚡"
        ;;
    refactor)
        EMOJI="♻️"
        ;;
    revert)
        EMOJI="⏪"
        ;;
    style)
        EMOJI="💄"
        ;;
    test)
        EMOJI="✅"
        ;;
esac

# 첫 번째 줄 앞에 이모지 추가
TEMP_FILE="${COMMIT_MSG_FILE}.tmp"

{
    echo "$EMOJI $COMMIT_MSG"
    tail -n +2 "$COMMIT_MSG_FILE"
} > "$TEMP_FILE"

mv "$TEMP_FILE" "$COMMIT_MSG_FILE"

exit 0